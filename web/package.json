{
  "name": "covenants-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.functions.json",
    "wasm": "wasm-pack build ../crates/wasm --target web --out-dir ../../web/pkg --out-name covenants",
